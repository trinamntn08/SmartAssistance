# Copy this file to .env for local development.
# Add variable names and safe example values only; never commit real credentials.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=8192
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_REWRITES=4
MAX_BODY_BYTES=65536
# Required when NODE_ENV=production until OAuth is implemented.
SMARTASSISTANCE_API_TOKEN=
# Required in production: comma-separated exact Chrome extension origins.
SMARTASSISTANCE_ALLOWED_ORIGINS=
# Export this variable in the extension build shell to override the local API.
SMARTASSISTANCE_API_BASE_URL=http://127.0.0.1:8787
